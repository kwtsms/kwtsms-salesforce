<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <label>kwtSMS Order Status Changed</label>
    <description>Sends SMS notification when an Order Status changes</description>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Handle_SMS_Event</targetReference>
        </connector>
        <object>Order</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
    </start>
    <actionCalls>
        <name>Handle_SMS_Event</name>
        <label>Handle SMS Event</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <actionName>KwtSMSFlowHandler</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>eventType</name>
            <value>
                <stringValue>Order_Status_Changed</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>objectType</name>
            <value>
                <stringValue>Order</stringValue>
            </value>
        </inputParameters>
    </actionCalls>
    <interviewLabel>kwtSMS Order Status Changed {!$Flow.CurrentDateTime}</interviewLabel>
</Flow>
